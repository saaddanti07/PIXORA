<?xml version="1.0" encoding="utf-8"?>
<!-- PIXORA launch screen: deep brand gradient with the sparkle mark centred. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#1D1548"
                android:endColor="#120E2B"
                android:startColor="#31246E"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
